APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql+psycopg://downtify:change-this-password@db:5432/downtify_saas
POSTGRES_DB=downtify_saas
POSTGRES_USER=downtify
POSTGRES_PASSWORD=change-this-password
REDIS_URL=redis://redis:6379/0
API_PORT=8088

# Safaricom Daraja sandbox credentials. Keep real values in .env only.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-https-domain.example/payments/mpesa/callback
